# better-auth 1.6.x declares peerOptional drizzle-kit >=0.31.4 and drizzle-orm ^0.45.2,
# while this project pins drizzle-kit 0.20.17 / drizzle-orm 0.30.10. Without this flag,
# `npm install` and `npm ci` fail ERESOLVE on that conflict. Removing it requires a real
# drizzle 0.30 -> 0.45 upgrade (schema + query API), not just deleting this line.
legacy-peer-deps=true
