# @vercel/analytics declares an OPTIONAL peer on @sveltejs/kit, which makes npm
# explore a Svelte -> Vite 8 chain that conflicts with this project's Vite 7
# (from vitest). Nothing Svelte is used here. legacy-peer-deps keeps npm install
# AND `npm ci` in CI from failing on that spurious optional-peer conflict.
legacy-peer-deps=true
