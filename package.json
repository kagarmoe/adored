{
  "name": "adored",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:tutorial": "(sleep 3 && (open http://localhost:3000/tutorial || xdg-open http://localhost:3000/tutorial || true) &) ; next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run db:backfill-numbers && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:db": "bash e2e/fixtures/run-db-tests.sh",
    "test:ci": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts",
    "db:generate": "drizzle-kit generate:pg --schema=src/lib/db/schema.ts --out=drizzle",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backfill-slugs": "tsx scripts/backfill-collection-slugs.ts",
    "db:backfill-numbers": "tsx scripts/backfill-session-result-numbers.ts",
    "auth:verify": "tsx -r ./scripts/load-env.js scripts/verify-auth.ts",
    "seed:load": "tsx scripts/seed-load.ts",
    "bench:recompute": "tsx scripts/bench-recompute.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.0",
    "@vercel/functions": "^3.7.5",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "0.7.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "0.20.17",
    "drizzle-orm": "0.30.10",
    "next": "14.2.35",
    "next-auth": "4.24.10",
    "postgres": "3.4.4",
    "posthog-js": "^1.396.3",
    "posthog-node": "^5.39.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.2",
    "tailwindcss": "3.4.1",
    "tsx": "^4.22.3",
    "ulid": "^2.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  }
}
