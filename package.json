{
  "name": "purseinator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "db:generate": "drizzle-kit generate:pg --schema=src/lib/db/schema.ts --out=drizzle",
    "db:migrate": "node -r esbuild-register scripts/migrate.ts",
    "auth:verify": "node -r ./scripts/load-env.js scripts/verify-auth.ts"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next-auth": "4.24.10",
    "@auth/drizzle-adapter": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "@vercel/blob": "0.23.4",
    "drizzle-orm": "0.30.10",
    "drizzle-kit": "0.20.17",
    "@vercel/postgres": "0.8.0",
    "postgres": "3.4.4",
    "zod": "3.23.8",
    "tailwindcss": "3.4.1",
    "class-variance-authority": "0.7.0",
    "ulid": "^2.3.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@vitejs/plugin-react": "^4.2.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "esbuild-register": "^3.5.0"
  }
}
