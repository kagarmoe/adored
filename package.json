{
  "name": "adored",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run db:backfill-numbers && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:db": "bash e2e/fixtures/run-db-tests.sh",
    "test:ci": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:generate": "drizzle-kit generate:pg --schema=src/lib/db/schema.ts --out=drizzle",
    "db:migrate": "node -r esbuild-register scripts/migrate.ts",
    "db:backfill-slugs": "node -r esbuild-register scripts/backfill-collection-slugs.ts",
    "db:backfill-numbers": "node -r esbuild-register scripts/backfill-session-result-numbers.ts",
    "auth:verify": "node -r ./scripts/load-env.js scripts/verify-auth.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.0",
    "@vercel/postgres": "0.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "0.7.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "0.20.17",
    "drizzle-orm": "0.30.10",
    "next": "14.2.3",
    "next-auth": "4.24.10",
    "postgres": "3.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.2",
    "tailwindcss": "3.4.1",
    "tsx": "^4.22.3",
    "ulid": "^2.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.0",
    "culori": "^4.0.2",
    "esbuild-register": "^3.5.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.5",
    "vitest": "^1.0.0"
  }
}
