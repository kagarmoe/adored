#!/bin/sh
# Pre-push gate: mirror CI locally so failures are caught before they leave
# your machine. Mirrors .github/workflows/ci.yml (lint + unit tests + build).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in a pinch:       git push --no-verify
#
# Build needs dummy env (src/lib/env.ts validates at module load); real values
# come from Vercel at runtime.

set -e

# Doc-sync backstop (soft): soft-block a push whose changed source files have
# un-synced docs (docs/doc-ownership.md). Override: git push --no-verify.
echo "pre-push: doc-sync check…"
docs_only=1   # cleared if any pushed file is outside docs (*.md, docs/)
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # deleting a ref
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ;;                                             # existing remote branch
    *) base=$(git merge-base origin/main "$local_sha" 2>/dev/null \
              || git rev-list --max-parents=0 "$local_sha" | tail -1) ;;      # new branch
  esac
  files=$(git diff --name-only --diff-filter=ACMRT "$base".."$local_sha")
  [ -n "$files" ] && printf '%s\n' "$files" | node scripts/hooks/doc-check.mjs
  if [ -n "$files" ] && printf '%s\n' "$files" | grep -qvE '\.md$|^docs/'; then docs_only=0; fi
done

# Docs-only pushes can't break lint/tests/build; CI still runs on the PR.
if [ "$docs_only" = 1 ]; then
  echo "pre-push: docs-only push — skipping lint/test/build (CI still runs)"
else
  echo "pre-push: lint…"
  npm run lint

  echo "pre-push: unit tests…"
  npm run test:ci

  echo "pre-push: build…"
  DATABASE_URL="postgresql://user:pass@localhost:5432/ci" \
  AUTH_URL="http://localhost:3000" \
  AUTH_SECRET="ci-build-only-secret-at-least-32-characters-long" \
  npm run build

  echo "pre-push: all checks passed ✓"
fi

# Mirror beads -> GitHub Project board. NEVER blocks the push (the gate above
# already passed). This lives here, not in .git/hooks/, because this repo sets
# core.hooksPath=.githooks — a hook in .git/hooks/pre-push is silently ignored.
BEADS_GH_SYNC_DIR="$HOME/repos/beads-gh-sync"
if [ -d "$BEADS_GH_SYNC_DIR" ]; then
  echo "pre-push: syncing beads → GitHub…"
  PYTHONPATH="$BEADS_GH_SYNC_DIR/src" python3 -m beads_gh_sync.cli push \
    --repo "$(git rev-parse --show-toplevel)" \
    || echo "[beads-gh-sync] sync error (ignored)" >&2
fi
