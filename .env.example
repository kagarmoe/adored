# Database
DATABASE_URL=postgresql://localhost/purseinator

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Email configuration (development: use MailHog on localhost:1025)
EMAIL_FROM=noreply@purseinator.app
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
# For production, uncomment and set these:
# EMAIL_SERVER_USER=your-smtp-user
# EMAIL_SERVER_PASSWORD=your-smtp-password
