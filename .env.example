# Application environment
NODE_ENV=development

# Database - PostgreSQL connection string
# Local development: postgresql://user:password@localhost:5432/adored
# Production: Use Vercel Postgres or managed PostgreSQL service
DATABASE_URL=postgresql://localhost:5432/adored

# NextAuth Configuration - Session Management
# Vercel provides these as AUTH_URL / AUTH_SECRET (not NEXTAUTH_*).
# The app bridges them to NextAuth v4's NEXTAUTH_* convention at runtime.
# AUTH_URL: Public-facing URL of the application
AUTH_URL=http://localhost:3000
# AUTH_SECRET: Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-minimum-32-characters-required

# Email Configuration
# EMAIL_FROM: Sender email address for transactional emails
EMAIL_FROM=noreply@adored.kimberlygarmoe.com

# Development: MailHog test server (localhost:1025)
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Production: Uncomment and set your SMTP provider credentials
# Examples: Resend, SendGrid, AWS SES, Postmark, etc.
# EMAIL_SERVER_USER=your-smtp-user
# EMAIL_SERVER_PASSWORD=your-smtp-password

# Vercel Blob Storage - Photo/media storage
# Auto-configured in Vercel environment; optional for local development
# BLOB_READ_WRITE_TOKEN=vercel_blob_token_here
