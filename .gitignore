# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.headroom-venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local runtime config — env-specific (dolt mode/host/port). Must NOT be
# committed: a stale committed value is a landmine that `git reset --hard`
# re-introduces, masking the real Dolt DB as an orphan. (See bead purses-ok6.)
.beads/metadata.json

# Exception: DO commit src/lib (overrides global .gitignore_python)
!src/lib/

# Playwright auth storageState (secrets — never commit)
/e2e/.auth/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# beads↔GitHub sync map — per-machine state from beads-gh-sync. A known bug
# duplicates GitHub issues when this is shared; managed manually now, so it is
# local-only and untracked. (See GitHub issue dedup, 2026-06-13.)
.beads/gh-sync-map.json

# beads:audit interaction log — append-only, per-machine; not shared.
.beads/interactions.jsonl

# Superpowers brainstorm visual companion artifacts
.superpowers/

# Skills package manager: commit the lockfile (skills-lock.json), but ignore the
# installed skill content and the symlinks into it — reconstructable from the
# lock, like node_modules. (See skills-lock.json for the pinned sources/hashes.)
/.agents/
/.claude/skills/*
# Project automation skills — committed for now; move upstream once proven.
!/.claude/skills/sync-docs/
!/.claude/skills/close-out/
!/.claude/skills/pr-screenshots/

# Per-machine Claude Code overrides (e.g. worktree.bgIsolation for a background
# session). Never committed — committed config is in .claude/settings.json.
/.claude/settings.local.json

# PR screenshots (live on GitHub releases, never committed — see docs/cookbook/add-images-to-pr.md)
# Anchored to repo root so it doesn't also swallow .claude/skills/pr-screenshots/.
/pr-screenshots/

# vitest blob reports (per-tier coverage, merged in CI)
/.vitest-reports/
.env.local

# graphify snapshots the PREVIOUS graph into a dated dir on every update. It is a
# stale rebuild artifact, not source — and it carries its own GRAPH_REPORT.md, the
# exact file CLAUDE.md tells agents to read for architecture. A tracked copy is an
# outdated second source of truth an agent can grep. (One landed on main in #316.)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# derived per-spec labeled test images — regenerated by e2e global-setup
/e2e/fixtures/sample-images/labeled/

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section
