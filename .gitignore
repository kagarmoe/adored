# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local runtime config — env-specific (dolt mode/host/port). Must NOT be
# committed: a stale committed value is a landmine that `git reset --hard`
# re-introduces, masking the real Dolt DB as an orphan. (See bead purses-ok6.)
.beads/metadata.json

# Exception: DO commit src/lib (overrides global .gitignore_python)
!src/lib/

# Playwright auth storageState (secrets — never commit)
/e2e/.auth/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# beads↔GitHub sync map — per-machine state from beads-gh-sync. A known bug
# duplicates GitHub issues when this is shared; managed manually now, so it is
# local-only and untracked. (See GitHub issue dedup, 2026-06-13.)
.beads/gh-sync-map.json

# beads:audit interaction log — append-only, per-machine; not shared.
.beads/interactions.jsonl

# Superpowers brainstorm visual companion artifacts
.superpowers/

# Skills package manager: commit the lockfile (skills-lock.json), but ignore the
# installed skill content and the symlinks into it — reconstructable from the
# lock, like node_modules. (See skills-lock.json for the pinned sources/hashes.)
/.agents/
/.claude/skills/*
# Project automation skills — committed for now; move upstream once proven.
!/.claude/skills/sync-docs/
!/.claude/skills/close-out/
!/.claude/skills/pr-screenshots/

# Per-machine Claude Code overrides (e.g. worktree.bgIsolation for a background
# session). Never committed — committed config is in .claude/settings.json.
/.claude/settings.local.json

# PR screenshots (live on GitHub releases, never committed — see docs/cookbook/add-images-to-pr.md)
# Anchored to repo root so it doesn't also swallow .claude/skills/pr-screenshots/.
/pr-screenshots/

# vitest blob reports (per-tier coverage, merged in CI)
/.vitest-reports/
.env.local
