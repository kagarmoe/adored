generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  role        Role
  createdAt   DateTime     @default(now())
  collections Collection[]
  sessions    Session[]
  accounts    Account[]
}

model Collection {
  id          Int      @id @default(autoincrement())
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     Int
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  items       Item[]
}

model Item {
  id             Int          @id @default(autoincrement())
  collection     Collection   @relation(fields: [collectionId], references: [id])
  collectionId   Int
  brand          String       @default("")
  style          String       @default("")
  color          String       @default("")
  material       String       @default("")
  eloRating      Float        @default(1000)
  createdAt      DateTime     @default(now())
  photos         Photo[]
  comparisonsAsA Comparison[] @relation("ItemA")
  comparisonsAsB Comparison[] @relation("ItemB")
  wins           Comparison[] @relation("Winner")
}

model Photo {
  id              Int      @id @default(autoincrement())
  item            Item     @relation(fields: [itemId], references: [id])
  itemId          Int
  blobKey         String   @unique
  originalBlobKey String   @unique
  bgRemoved       Boolean  @default(false)
  isHero          Boolean  @default(false)
  uploadedAt      DateTime @default(now())
}

model Comparison {
  id        Int      @id @default(autoincrement())
  itemA     Item     @relation("ItemA", fields: [itemAId], references: [id])
  itemAId   Int
  itemB     Item     @relation("ItemB", fields: [itemBId], references: [id])
  itemBId   Int
  winner    Item     @relation("Winner", fields: [winnerId], references: [id])
  winnerId  Int
  infoShown String
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  operator
  curator
}
